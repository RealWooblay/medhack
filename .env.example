# Browser-safe build settings. VITE_ values are public after the app is built.
VITE_MEDGEMMA_ENDPOINT=/api/clinical-review

# Vercel-to-Google Cloud identity federation. Keep every value server-side.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# HTTPS custom audience used to mint the Vercel OIDC token; see DEPLOYMENT.md.
GCP_AUDIENCE=

# Real MedGemma deployment created from Vertex AI Model Garden.
MEDGEMMA_VERTEX_LOCATION=
MEDGEMMA_VERTEX_ENDPOINT_ID=
# Server-attested model/revision label shown in the audit record.
MEDGEMMA_MODEL_ID=google/medgemma-27b-text-it@REPLACE_WITH_DEPLOYED_REVISION
# Optional hostname only, returned as dedicatedEndpointDns by Vertex AI.
MEDGEMMA_VERTEX_DEDICATED_DNS=

# Real PharmCAT service. The browser must upload raw genome files directly to
# the private bucket using a run-scoped upload session created by the API.
PHARMCAT_SERVICE_URL=
PHARMCAT_SERVICE_AUDIENCE=
PHARMCAT_UPLOAD_BUCKET=
