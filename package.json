{
  "name": "antidepressant-pgx-agent",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "version": "0.1.0",
  "type": "module",
  "description": "Genome-to-guidance antidepressant pharmacogenomics with PharmCAT, drug-specific daily life and constrained medical AI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'services/**' --exclude 'src/engine/__tests__/support-protocols.test.ts'",
    "test:research": "vitest run src/engine/__tests__/support-protocols.test.ts",
    "test:watch": "vitest --exclude 'services/**'",
    "test:control": "npm test --prefix services/pharmcat-control",
    "test:worker": "cd services/pharmcat-worker && go test ./...",
    "test:all": "npm test && npm run test:research && npm run test:control && npm run test:worker",
    "data:sync": "node scripts/sync-clinical-sources.mjs"
  },
  "dependencies": {
    "@vercel/oidc": "^3.8.0",
    "google-auth-library": "^10.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
